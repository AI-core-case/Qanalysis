# Copie para .env e preencha com os seus valores.
# O .env real e ignorado pelo git — nada daqui vai para o repositorio.

# Qase (opcional) — gestao de casos de teste
QASE_API_TOKEN=SEU_TOKEN_AQUI
QASE_PROJECT_CODE=SEU_PROJETO

# YouTrack (opcional) — gestao de issues
YOUTRACK_TOKEN=SEU_TOKEN_AQUI
YOUTRACK_URL=https://sua-instancia.youtrack.cloud

# Onde a memoria do seu contexto fica guardada (local, nunca versionada)
MEMORY_DIR=.memory
