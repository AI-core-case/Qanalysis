# Copy this to .env and fill it with your own values.
# The real .env is ignored by git — nothing here reaches the repository.

# Qase (optional) — test case management
QASE_API_TOKEN=YOUR_TOKEN_HERE
QASE_PROJECT_CODE=YOUR_PROJECT

# Jam (optional) — evidence recordings, read through the CLI
JAM_TOKEN=YOUR_TOKEN_HERE

# Where your product memory lives (local, never versioned)
MEMORY_DIR=app-memory
